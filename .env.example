# Unique name matching your InnoPool route (e.g. pool-cpu-<id>)
SLAVE_NAME=pool-cpu-changeme

# InnoPool master
MASTER_IP=master.innopool.co.uk
MASTER_PORT=80

# Parallel nonce workers — typically ≈ host vCPUs
NUM_WORKERS=16

# Local artifact TTL (seconds)
TTL=3600

# TIG runtime image tag (challenge containers)
TIG_VERSION=latest

# Host paths for algorithm binaries + batch results
ALGORITHMS_DIR=./data/algorithms
RESULTS_DIR=./data/results

# Dashboard published on host (container listens on 8787)
DASHBOARD_HOST_PORT=8787

# Set to 1 for full per-nonce debug logs
VERBOSE=

# Optional override of reported slave version string
# INNOPOOL_SLAVE_VERSION=innopool-slave/0.1.7
